{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate Eval custom resource for OAC #76 (not accepted upstream)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "target",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceIdentifier",
        "version"
      ],
      "properties": {
        "resourceIdentifier": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "input",
          "expectedBehavior"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string",
            "maxLength": 8192
          },
          "expectedBehavior": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
